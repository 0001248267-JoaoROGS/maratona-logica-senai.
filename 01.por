programa
{
    funcao inicio()
    {
        cadeia nome // Guarda o nome do colaborador

        escreva("Digite o nome do colaborador: ") // Solicita o nome ao usuário
        leia(nome) // Lê o nome digitado

        escreva("Olá ", nome, ", seu turno de 8h na Indústria 4.0 começou. Bom trabalho!") // Exibe a mensagem final
    }
}
