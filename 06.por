programa
{
    funcao inicio()
    {
        real largura, comprimento, area // Declara largura, comprimento e área

        escreva("Digite a largura do galpão: ") // Solicita a largura
        leia(largura) // Lê a largura

        escreva("Digite o comprimento do galpão: ") // Solicita o comprimento
        leia(comprimento) // Lê o comprimento

        area = largura * comprimento // Calcula a área retangular

        escreva("Área total do galpão: ", area, " m²") // Exibe a metragem quadrada
    }
}
